	<queryString>
		<![CDATA[select reg_periksa.no_rawat,pasien.no_rkm_medis,pasien.nm_pasien,pasien.jk,pasien.tgl_lahir,penilaian_bishop_scor.kd_dokter,dokter.nm_dokter,
penilaian_bishop_scor.tanggal,penilaian_bishop_scor.pembukaan,penilaian_bishop_scor.skor_pembukaan,penilaian_bishop_scor.pendataran,penilaian_bishop_scor.skor_pendataran,
penilaian_bishop_scor.station,penilaian_bishop_scor.skor_station,penilaian_bishop_scor.konsistensi,penilaian_bishop_scor.skor_konsistensi,penilaian_bishop_scor.posisi,
penilaian_bishop_scor.skor_posisi,penilaian_bishop_scor.skor,penilaian_bishop_scor.kategori,penilaian_bishop_scor.keterangan
from penilaian_bishop_scor inner join reg_periksa on penilaian_bishop_scor.no_rawat=reg_periksa.no_rawat inner join pasien on reg_periksa.no_rkm_medis=pasien.no_rkm_medis
inner join dokter on penilaian_bishop_scor.kd_dokter=dokter.kd_dokter]]>
	</queryString>
