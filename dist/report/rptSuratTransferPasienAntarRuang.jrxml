	<field name="petugasmenyerahkan" class="java.lang.String"/>
	<field name="nip_menerima" class="java.lang.String"/>
	<field name="petugasmenerima" class="java.lang.String"/>
	<title>
		<band height="75">
			<image>
				<reportElement x="0" y="0" width="65" height="65"/>
				<imageExpression><![CDATA[$P{logo}]]></imageExpression>
			</image>
			<textField>
				<reportElement x="70" y="0" width="485" height="20" style="val"/>
				<textElement textAlignment="Center"><font fontName="Tahoma" size="14" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$P{namars}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="70" y="20" width="485" height="30" style="val"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA[$P{alamatrs}+", "+$P{kotars}+", "+$P{propinsirs}+"\n"+$P{kontakrs}+", E-mail : "+$P{emailrs}]]></textFieldExpression>
			</textField>
			<line><reportElement x="0" y="70" width="555" height="1"/></line>
		</band>
	</title>
	<detail>
		<band height="640">
			<staticText>
				<reportElement x="0" y="0" width="555" height="18"/>
				<textElement textAlignment="Center"><font fontName="Tahoma" size="11" isBold="true"/></textElement>
				<text><![CDATA[TRANSFER PASIEN ANTAR RUANG]]></text>
			</staticText>

			<!-- Identitas -->
			<staticText><reportElement x="0" y="24" width="90" height="12" style="lbl"/><text><![CDATA[No.Rawat]]></text></staticText>
			<textField><reportElement x="90" y="24" width="185" height="12" style="val"/><textFieldExpression><![CDATA[": "+$F{no_rawat}]]></textFieldExpression></textField>
			<staticText><reportElement x="280" y="24" width="90" height="12" style="lbl"/><text><![CDATA[No.RM]]></text></staticText>
			<textField><reportElement x="370" y="24" width="185" height="12" style="val"/><textFieldExpression><![CDATA[": "+$F{no_rkm_medis}]]></textFieldExpression></textField>
			<staticText><reportElement x="0" y="37" width="90" height="12" style="lbl"/><text><![CDATA[Nama Pasien]]></text></staticText>
			<textField><reportElement x="90" y="37" width="185" height="12" style="val"/><textFieldExpression><![CDATA[": "+$F{nm_pasien}]]></textFieldExpression></textField>
			<staticText><reportElement x="280" y="37" width="90" height="12" style="lbl"/><text><![CDATA[Tgl.Lahir / J.K.]]></text></staticText>
			<textField><reportElement x="370" y="37" width="185" height="12" style="val"/><textFieldExpression><![CDATA[": "+$F{tgl_lahir}+" / "+($F{jk}.equals("L")?"Laki-Laki":"Perempuan")]]></textFieldExpression></textField>
			<staticText><reportElement x="0" y="50" width="90" height="12" style="lbl"/><text><![CDATA[Alamat]]></text></staticText>
			<textField isStretchWithOverflow="true"><reportElement x="90" y="50" width="465" height="12" style="val"/><textFieldExpression><![CDATA[": "+$F{alamat_pasien}]]></textFieldExpression></textField>
			<staticText><reportElement x="0" y="63" width="90" height="12" style="lbl"/><text><![CDATA[Tanggal Masuk]]></text></staticText>
			<textField><reportElement x="90" y="63" width="185" height="12" style="val"/><textFieldExpression><![CDATA[": "+$F{tanggal_masuk}]]></textFieldExpression></textField>
			<staticText><reportElement x="280" y="63" width="90" height="12" style="lbl"/><text><![CDATA[Tanggal Pindah]]></text></staticText>
			<textField><reportElement x="370" y="63" width="185" height="12" style="val"/><textFieldExpression><![CDATA[": "+$F{tanggal_pindah}]]></textFieldExpression></textField>

			<!-- Pemindahan -->
			<staticText><reportElement x="0" y="80" width="555" height="13" style="sec"/><text><![CDATA[ INFORMASI PEMINDAHAN]]></text></staticText>
			<staticText><reportElement x="0" y="96" width="120" height="12" style="lbl"/><text><![CDATA[Indikasi Pindah]]></text></staticText>
			<textField isStretchWithOverflow="true"><reportElement x="120" y="96" width="435" height="12" style="val"/><textFieldExpression><![CDATA[": "+$F{indikasi_pindah_ruang}+($F{keterangan_indikasi_pindah_ruang}.trim().equals("")?"":" ("+$F{keterangan_indikasi_pindah_ruang}+")")]]></textFieldExpression></textField>
			<staticText><reportElement x="0" y="109" width="120" height="12" style="lbl"/><text><![CDATA[Asal Ruang / Poli]]></text></staticText>
			<textField><reportElement x="120" y="109" width="435" height="12" style="val"/><textFieldExpression><![CDATA[": "+$F{asal_ruang}]]></textFieldExpression></textField>
			<staticText><reportElement x="0" y="122" width="120" height="12" style="lbl"/><text><![CDATA[Ruang Selanjutnya]]></text></staticText>
			<textField><reportElement x="120" y="122" width="435" height="12" style="val"/><textFieldExpression><![CDATA[": "+$F{ruang_selanjutnya}]]></textFieldExpression></textField>
			<staticText><reportElement x="0" y="135" width="120" height="12" style="lbl"/><text><![CDATA[Metode Pemindahan]]></text></staticText>
			<textField><reportElement x="120" y="135" width="435" height="12" style="val"/><textFieldExpression><![CDATA[": "+$F{metode_pemindahan_pasien}]]></textFieldExpression></textField>
			<staticText><reportElement x="0" y="148" width="120" height="12" style="lbl"/><text><![CDATA[Diagnosa Utama]]></text></staticText>
			<textField isStretchWithOverflow="true"><reportElement x="120" y="148" width="435" height="12" style="val"/><textFieldExpression><![CDATA[": "+$F{diagnosa_utama}]]></textFieldExpression></textField>
			<staticText><reportElement x="0" y="161" width="120" height="12" style="lbl"/><text><![CDATA[Diagnosa Sekunder]]></text></staticText>
			<textField isStretchWithOverflow="true"><reportElement x="120" y="161" width="435" height="12" style="val"/><textFieldExpression><![CDATA[": "+$F{diagnosa_sekunder}]]></textFieldExpression></textField>
			<staticText><reportElement x="0" y="174" width="120" height="12" style="lbl"/><text><![CDATA[Prosedur Dilakukan]]></text></staticText>
			<textField isStretchWithOverflow="true"><reportElement x="120" y="174" width="435" height="12" style="val"/><textFieldExpression><![CDATA[": "+$F{prosedur_yang_sudah_dilakukan}]]></textFieldExpression></textField>
			<staticText><reportElement x="0" y="187" width="120" height="12" style="lbl"/><text><![CDATA[Obat Diberikan]]></text></staticText>
			<textField isStretchWithOverflow="true"><reportElement x="120" y="187" width="435" height="12" style="val"/><textFieldExpression><![CDATA[": "+$F{obat_yang_telah_diberikan}]]></textFieldExpression></textField>
			<staticText><reportElement x="0" y="200" width="120" height="12" style="lbl"/><text><![CDATA[Pemeriksaan Penunjang]]></text></staticText>
			<textField isStretchWithOverflow="true"><reportElement x="120" y="200" width="435" height="12" style="val"/><textFieldExpression><![CDATA[": "+$F{pemeriksaan_penunjang_yang_dilakukan}]]></textFieldExpression></textField>
			<staticText><reportElement x="0" y="213" width="120" height="12" style="lbl"/><text><![CDATA[Peralatan Menyertai]]></text></staticText>
			<textField isStretchWithOverflow="true"><reportElement x="120" y="213" width="435" height="12" style="val"/><textFieldExpression><![CDATA[": "+$F{peralatan_yang_menyertai}+($F{keterangan_peralatan_yang_menyertai}.trim().equals("")?"":" ("+$F{keterangan_peralatan_yang_menyertai}+")")]]></textFieldExpression></textField>

			<!-- Persetujuan -->
			<staticText><reportElement x="0" y="230" width="555" height="13" style="sec"/><text><![CDATA[ PERSETUJUAN PASIEN / KELUARGA]]></text></staticText>
			<staticText><reportElement x="0" y="246" width="120" height="12" style="lbl"/><text><![CDATA[Menyetujui Pemindahan]]></text></staticText>
			<textField><reportElement x="120" y="246" width="435" height="12" style="val"/><textFieldExpression><![CDATA[": "+$F{pasien_keluarga_menyetujui}]]></textFieldExpression></textField>
			<staticText><reportElement x="0" y="259" width="120" height="12" style="lbl"/><text><![CDATA[Nama / Hubungan]]></text></staticText>
			<textField><reportElement x="120" y="259" width="435" height="12" style="val"/><textFieldExpression><![CDATA[": "+$F{nama_menyetujui}+" / "+$F{hubungan_menyetujui}]]></textFieldExpression></textField>

			<!-- Keadaan -->
			<staticText><reportElement x="0" y="276" width="275" height="13" style="sec"/><text><![CDATA[ KEADAAN SEBELUM TRANSFER]]></text></staticText>
			<staticText><reportElement x="280" y="276" width="275" height="13" style="sec"/><text><![CDATA[ KEADAAN SETELAH TRANSFER]]></text></staticText>
			<textField isStretchWithOverflow="true"><reportElement x="0" y="292" width="275" height="12" style="val"/><textFieldExpression><![CDATA["Keadaan Umum : "+$F{keadaan_umum_sebelum_transfer}]]></textFieldExpression></textField>
			<textField isStretchWithOverflow="true"><reportElement x="280" y="292" width="275" height="12" style="val"/><textFieldExpression><![CDATA["Keadaan Umum : "+$F{keadaan_umum_sesudah_transfer}]]></textFieldExpression></textField>
			<textField><reportElement x="0" y="305" width="275" height="12" style="val"/><textFieldExpression><![CDATA["TD : "+$F{td_sebelum_transfer}+" mmHg   Nadi : "+$F{nadi_sebelum_transfer}+" x/menit"]]></textFieldExpression></textField>
			<textField><reportElement x="280" y="305" width="275" height="12" style="val"/><textFieldExpression><![CDATA["TD : "+$F{td_sesudah_transfer}+" mmHg   Nadi : "+$F{nadi_sesudah_transfer}+" x/menit"]]></textFieldExpression></textField>
			<textField><reportElement x="0" y="318" width="275" height="12" style="val"/><textFieldExpression><![CDATA["RR : "+$F{rr_sebelum_transfer}+" x/menit   Suhu : "+$F{suhu_sebelum_transfer}+" °C"]]></textFieldExpression></textField>
			<textField><reportElement x="280" y="318" width="275" height="12" style="val"/><textFieldExpression><![CDATA["RR : "+$F{rr_sesudah_transfer}+" x/menit   Suhu : "+$F{suhu_sesudah_transfer}+" °C"]]></textFieldExpression></textField>
			<textField isStretchWithOverflow="true"><reportElement x="0" y="331" width="275" height="36" style="val"/><textFieldExpression><![CDATA["Keluhan Utama : "+$F{keluhan_utama_sebelum_transfer}]]></textFieldExpression></textField>
			<textField isStretchWithOverflow="true"><reportElement x="280" y="331" width="275" height="36" style="val"/><textFieldExpression><![CDATA["Keluhan Utama : "+$F{keluhan_utama_sesudah_transfer}]]></textFieldExpression></textField>

			<!-- Tanda tangan -->
			<staticText><reportElement x="0" y="380" width="275" height="13" style="lbl"/><textElement textAlignment="Center"/><text><![CDATA[Petugas Yang Menyerahkan]]></text></staticText>
			<staticText><reportElement x="280" y="380" width="275" height="13" style="lbl"/><textElement textAlignment="Center"/><text><![CDATA[Petugas Yang Menerima]]></text></staticText>
			<textField isStretchWithOverflow="true"><reportElement x="0" y="395" width="275" height="50" style="val"/><textElement textAlignment="Center"><font fontName="Tahoma" size="7"/></textElement><textFieldExpression><![CDATA[$P{finger}]]></textFieldExpression></textField>
			<textField isStretchWithOverflow="true"><reportElement x="280" y="395" width="275" height="50" style="val"/><textElement textAlignment="Center"><font fontName="Tahoma" size="7"/></textElement><textFieldExpression><![CDATA[$P{finger2}]]></textFieldExpression></textField>

			<!-- Bukti persetujuan -->
			<staticText><reportElement x="0" y="455" width="555" height="13" style="sec"/><text><![CDATA[ BUKTI PENGAMBILAN PERSETUJUAN]]></text></staticText>
			<image scaleImage="RetainShape" hAlign="Center" onErrorType="Blank">
				<reportElement x="127" y="472" width="300" height="165"/>
				<imageExpression><![CDATA[$P{photo}]]></imageExpression>
			</image>
		</band>
