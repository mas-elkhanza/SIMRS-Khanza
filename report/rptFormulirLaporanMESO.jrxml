	<queryString language="SQL">
		<![CDATA[select laporan_meso.no_laporan,laporan_meso.tanggal,pasien.nm_pasien,
                date_format(pasien.tgl_lahir,'%d-%m-%Y') as tgl_lahir,suku_bangsa.nama_suku_bangsa as suku,
                laporan_meso.berat_badan,pasien.pekerjaan,pasien.jk,
                laporan_meso.anamnesa,laporan_meso.penyakit_utama,laporan_meso.kesudahan_penyakit,laporan_meso.gangguan_ginjal,
                laporan_meso.gangguan_hati,laporan_meso.alergi,laporan_meso.kondisi_medis_lain,laporan_meso.faktor_industri,
                laporan_meso.lain_lain,laporan_meso.ket_lain_lain,laporan_meso.manifestasi_eso,laporan_meso.masalah_mutu,
                laporan_meso.tgl_mula_eso,laporan_meso.kesudahan_eso,laporan_meso.tgl_kesudahan_eso,laporan_meso.riwayat_eso,
                laporan_meso.keterangan_tambahan,laporan_meso.data_laboratorium,laporan_meso.tgl_pemeriksaan_lab,laporan_meso.naranjo_1,
                laporan_meso.naranjo_2,laporan_meso.naranjo_3,laporan_meso.naranjo_4,laporan_meso.naranjo_5,
                laporan_meso.naranjo_6,laporan_meso.naranjo_7,laporan_meso.naranjo_8,laporan_meso.naranjo_9,
                laporan_meso.naranjo_10,laporan_meso.skor_naranjo_1,laporan_meso.skor_naranjo_2,laporan_meso.skor_naranjo_3,laporan_meso.skor_naranjo_4,laporan_meso.skor_naranjo_5,laporan_meso.skor_naranjo_6,laporan_meso.skor_naranjo_7,laporan_meso.skor_naranjo_8,laporan_meso.skor_naranjo_9,laporan_meso.skor_naranjo_10,laporan_meso.skor_naranjo,laporan_meso.kategori_naranjo,laporan_meso_obat.nama_obat,
                laporan_meso_obat.bentuk_sediaan,laporan_meso_obat.obat_jkn,laporan_meso_obat.no_batch,laporan_meso_obat.obat_dicurigai,
                laporan_meso_obat.cara,laporan_meso_obat.dosis_waktu,laporan_meso_obat.tgl_mulai,laporan_meso_obat.tgl_akhir,
                laporan_meso_obat.indikasi,petugas.nama,jabatan.nm_jbtn from laporan_meso inner join reg_periksa on laporan_meso.no_rawat=reg_periksa.no_rawat
                inner join pasien on reg_periksa.no_rkm_medis=pasien.no_rkm_medis
                inner join suku_bangsa on pasien.suku_bangsa=suku_bangsa.id
                inner join petugas on laporan_meso.nip=petugas.nip 
                inner join jabatan on petugas.kd_jbtn=jabatan.kd_jbtn inner join laporan_meso_obat on laporan_meso.no_laporan=laporan_meso_obat.no_laporan order by laporan_meso_obat.nama_obat]]>
	</queryString>
