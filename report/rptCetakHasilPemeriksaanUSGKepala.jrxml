	<queryString language="SQL">
		<![CDATA[select reg_periksa.no_rawat,pasien.no_rkm_medis,pasien.nm_pasien,
                pasien.tgl_lahir,hasil_pemeriksaan_usg_kepala.tanggal,hasil_pemeriksaan_usg_kepala.kd_dokter,
                dokter.nm_dokter,hasil_pemeriksaan_usg_kepala.diagnosa_klinis,hasil_pemeriksaan_usg_kepala.kiriman_dari,
                hasil_pemeriksaan_usg_kepala.sistem_ventrikel,hasil_pemeriksaan_usg_kepala.perdarahan_ivh,hasil_pemeriksaan_usg_kepala.parenkim_otak,
                hasil_pemeriksaan_usg_kepala.garis_tengah,hasil_pemeriksaan_usg_kepala.fossa_posterior,hasil_pemeriksaan_usg_kepala.ruang_ekstra_aksial,
                hasil_pemeriksaan_usg_kepala.doppler_ri,hasil_pemeriksaan_usg_kepala.kesimpulan from reg_periksa inner join pasien on reg_periksa.no_rkm_medis=pasien.no_rkm_medis 
                inner join hasil_pemeriksaan_usg_kepala on reg_periksa.no_rawat=hasil_pemeriksaan_usg_kepala.no_rawat 
                inner join dokter on hasil_pemeriksaan_usg_kepala.kd_dokter=dokter.kd_dokter]]>
