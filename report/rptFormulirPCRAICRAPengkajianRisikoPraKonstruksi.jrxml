	<queryString language="SQL">
		<![CDATA[select h.no_pcra,h.no_proyek,h.nama_proyek,h.lokasi_proyek,h.mulai_proyek,h.perkiraan_selesai,h.deskripsi_pekerjaan,h.penangung_jawab_proyek,h.pelaksana_proyek,a.nama_aktivitas,h.deskripsi_lokasi_proyek,h.penyebab_risiko_lainnya,k.nama_kelas,h.dibutuhkan_icra,h.rekomendasi_selama_pengerjaan,h.rekomendasi_setelah_pengerjaan,h.hal_yang_perlu_dimonitor,h.catatan_tim_ppi_k3_lainnya,timk3.nama as nama_timk3,pjproyek.nama as nama_pjproyek,manager.nama as nama_manajer,direktur.nama as nama_direktur,h.tanggal_pengkajian,j.urut,j.jenis,i.uraian from pcra_icra_pengkajian_risiko_prakonstruksi h inner join pegawai as timk3 on timk3.nik=h.nik_timk3 inner join pegawai as pjproyek on pjproyek.nik=h.nik_pjproyek inner join pegawai as manager on manager.nik=h.nik_manajer inner join pegawai as direktur on direktur.nik=h.nik_direktur inner join pcra_icra_jenis_aktivitas_proyek a on a.kode_aktivitas=h.kode_aktivitas inner join pcra_icra_kelas_risiko_pencegahan k on k.kode_kelas=h.kode_kelas_risiko inner join (select 1 as urut,'Kelompok Area Yang Terdampak' as jenis union all select 2,'Identifikasi Risiko Kebakaran' union all select 3,'Identifikasi Risiko Infeksi' union all select 4,'Identifikasi Risiko Keselamatan' union all select 5,'Identifikasi Risiko Utilitas' union all select 6,'Tindakan Pengendalian Yang Bisa Dilakukan' union all select 7,'Persyaratan Yang Harus Dipenuhi Sebelum Pengerjaan') as j left join (select 1 as urut,'' as uraian from dual where 1=0) as i on i.urut=j.urut order by j.urut,i.uraian]]>
	</queryString>
