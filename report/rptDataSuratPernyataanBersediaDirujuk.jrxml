	<queryString>
		<![CDATA[select surat_pernyataan_bersedia_dirujuk.no_surat,reg_periksa.no_rawat,pasien.no_rkm_medis,pasien.nm_pasien,surat_pernyataan_bersedia_dirujuk.tanggal,surat_pernyataan_bersedia_dirujuk.nama_pj,surat_pernyataan_bersedia_dirujuk.no_ktppj,surat_pernyataan_bersedia_dirujuk.tempat_lahirpj,surat_pernyataan_bersedia_dirujuk.lahirpj,surat_pernyataan_bersedia_dirujuk.jkpj,surat_pernyataan_bersedia_dirujuk.hubungan,surat_pernyataan_bersedia_dirujuk.no_telp,surat_pernyataan_bersedia_dirujuk.alamatpj,petugas.nama from surat_pernyataan_bersedia_dirujuk inner join reg_periksa on surat_pernyataan_bersedia_dirujuk.no_rawat=reg_periksa.no_rawat inner join pasien on reg_periksa.no_rkm_medis=pasien.no_rkm_medis inner join petugas on surat_pernyataan_bersedia_dirujuk.nip=petugas.nip]]>
