	<queryString>
		<![CDATA[select surat_kesediaan_menunggu_igd.no_surat,reg_periksa.no_rawat,pasien.no_rkm_medis,pasien.nm_pasien,surat_kesediaan_menunggu_igd.tanggal,surat_kesediaan_menunggu_igd.nama_pj,surat_kesediaan_menunggu_igd.no_ktppj,surat_kesediaan_menunggu_igd.tempat_lahirpj,surat_kesediaan_menunggu_igd.lahirpj,surat_kesediaan_menunggu_igd.jkpj,surat_kesediaan_menunggu_igd.hubungan,surat_kesediaan_menunggu_igd.no_telp,surat_kesediaan_menunggu_igd.alamatpj,petugas.nama from surat_kesediaan_menunggu_igd inner join reg_periksa on surat_kesediaan_menunggu_igd.no_rawat=reg_periksa.no_rawat inner join pasien on reg_periksa.no_rkm_medis=pasien.no_rkm_medis inner join petugas on surat_kesediaan_menunggu_igd.nip=petugas.nip]]>
