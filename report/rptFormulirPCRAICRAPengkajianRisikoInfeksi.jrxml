	<queryString language="SQL">
		<![CDATA[select pcra_icra_pengkajian_risiko_infeksi.no_icra,pcra_icra_pengkajian_risiko_infeksi.no_pcra,pcra_icra_pengkajian_risiko_infeksi.tanggal_pengkajian,pcra_icra_pengkajian_risiko_prakonstruksi.no_proyek,pcra_icra_pengkajian_risiko_prakonstruksi.nama_proyek,pcra_icra_pengkajian_risiko_prakonstruksi.lokasi_proyek,pcra_icra_pengkajian_risiko_prakonstruksi.pelaksana_proyek,pcra_icra_pengkajian_risiko_prakonstruksi.mulai_proyek,pcra_icra_pengkajian_risiko_prakonstruksi.perkiraan_selesai,pcra_icra_pengkajian_risiko_prakonstruksi.deskripsi_pekerjaan,pcra_icra_pengkajian_risiko_infeksi.kegiatan_lainnya,pcra_icra_pengkajian_risiko_infeksi.pekerjaan_lainnya,pcra_icra_pengkajian_risiko_infeksi.gangguan_lainnya,pcra_icra_pengkajian_risiko_infeksi.lokasi_sekitar,pcra_icra_pengkajian_risiko_infeksi.rute_pekerja,pcra_icra_pengkajian_risiko_infeksi.jam_mulai,pcra_icra_pengkajian_risiko_infeksi.jam_selesai,pcra_icra_pengkajian_risiko_infeksi.waktu_kerja,pcra_icra_pengkajian_risiko_infeksi.area_tetap_beroperasi,pcra_icra_pengkajian_risiko_infeksi.keterangan_operasi,pcra_icra_jenis_aktivitas_proyek.nama_aktivitas,pcra_icra_kelas_risiko_pencegahan.nama_kelas as risiko_pasien,pcra_icra_kelas_kewaspadaan.nama_kewaspadaan,pcra_icra_kelas_kewaspadaan.perlu_izin,pcra_icra_pengkajian_risiko_infeksi.alasan_kelas,pcra_icra_pengkajian_risiko_infeksi.keputusan,pcra_icra_pengkajian_risiko_infeksi.persyaratan,pemohon.nama as nama_pemohon,ipsrs.nama as nama_ipsrs,k3rs.nama as nama_k3rs,ppi.nama as nama_ppi,manajemen.nama as nama_manajemen,daftar_jenis.urut,daftar_jenis.jenis,isi_jenis.uraian,isi_jenis.keterangan,isi_jenis.pic from pcra_icra_pengkajian_risiko_infeksi inner join pcra_icra_pengkajian_risiko_prakonstruksi on pcra_icra_pengkajian_risiko_prakonstruksi.no_pcra=pcra_icra_pengkajian_risiko_infeksi.no_pcra inner join pcra_icra_jenis_aktivitas_proyek on pcra_icra_jenis_aktivitas_proyek.kode_aktivitas=pcra_icra_pengkajian_risiko_infeksi.kode_aktivitas inner join pcra_icra_kelas_risiko_pencegahan on pcra_icra_kelas_risiko_pencegahan.kode_kelas=pcra_icra_pengkajian_risiko_infeksi.kode_kelas_risiko inner join pcra_icra_kelas_kewaspadaan on pcra_icra_kelas_kewaspadaan.kode_kewaspadaan=pcra_icra_pengkajian_risiko_infeksi.kode_kewaspadaan inner join pegawai as pemohon on pemohon.nik=pcra_icra_pengkajian_risiko_infeksi.nik_pemohon inner join pegawai as ppi on ppi.nik=pcra_icra_pengkajian_risiko_infeksi.nik_ppi left join pegawai as ipsrs on ipsrs.nik=pcra_icra_pengkajian_risiko_infeksi.nik_ipsrs left join pegawai as k3rs on k3rs.nik=pcra_icra_pengkajian_risiko_infeksi.nik_k3rs left join pegawai as manajemen on manajemen.nik=pcra_icra_pengkajian_risiko_infeksi.nik_manajemen inner join (select 1 as urut,'Jenis Kegiatan' as jenis union all select 2,'Jenis Pekerjaan' union all select 3,'Potensi Gangguan' union all select 4,'Kelompok Pasien / Area Terdampak' union all select 5,'Rencana Pengendalian') as daftar_jenis left join (select 1 as urut,pcra_icra_jenis_kegiatan.nama_kegiatan as uraian,'' as keterangan,'' as pic from pcra_icra_pengkajian_risiko_infeksi_kegiatan inner join pcra_icra_jenis_kegiatan on pcra_icra_jenis_kegiatan.kode_kegiatan=pcra_icra_pengkajian_risiko_infeksi_kegiatan.kode_kegiatan where pcra_icra_pengkajian_risiko_infeksi_kegiatan.no_icra='' union all select 2,pcra_icra_jenis_pekerjaan.nama_pekerjaan as uraian,'' as keterangan,'' as pic from pcra_icra_pengkajian_risiko_infeksi_pekerjaan inner join pcra_icra_jenis_pekerjaan on pcra_icra_jenis_pekerjaan.kode_pekerjaan=pcra_icra_pengkajian_risiko_infeksi_pekerjaan.kode_pekerjaan where pcra_icra_pengkajian_risiko_infeksi_pekerjaan.no_icra='' union all select 3,pcra_icra_potensi_gangguan.nama_gangguan as uraian,'' as keterangan,'' as pic from pcra_icra_pengkajian_risiko_infeksi_gangguan inner join pcra_icra_potensi_gangguan on pcra_icra_potensi_gangguan.kode_gangguan=pcra_icra_pengkajian_risiko_infeksi_gangguan.kode_gangguan where pcra_icra_pengkajian_risiko_infeksi_gangguan.no_icra='' union all select 4,pcra_icra_lokasi_kelompok_risiko_area.nama_area as uraian,pcra_icra_pengkajian_risiko_infeksi_area.keterangan as keterangan,'' as pic from pcra_icra_pengkajian_risiko_infeksi_area inner join pcra_icra_lokasi_kelompok_risiko_area on pcra_icra_lokasi_kelompok_risiko_area.kode_area=pcra_icra_pengkajian_risiko_infeksi_area.kode_area where pcra_icra_pengkajian_risiko_infeksi_area.no_icra='' union all select 5,pcra_icra_tindakan_pengendalian.nama_pengendalian as uraian,pcra_icra_pengkajian_risiko_infeksi_pengendalian.rencana as keterangan,pcra_icra_pengkajian_risiko_infeksi_pengendalian.pic as pic from pcra_icra_pengkajian_risiko_infeksi_pengendalian inner join pcra_icra_tindakan_pengendalian on pcra_icra_tindakan_pengendalian.kode_pengendalian=pcra_icra_pengkajian_risiko_infeksi_pengendalian.kode_pengendalian where pcra_icra_pengkajian_risiko_infeksi_pengendalian.no_icra='') as isi_jenis on isi_jenis.urut=daftar_jenis.urut where pcra_icra_pengkajian_risiko_infeksi.no_icra='' order by daftar_jenis.urut,isi_jenis.uraian]]>
	</queryString>
