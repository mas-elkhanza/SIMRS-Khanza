	<queryString language="SQL">
		<![CDATA[select reg_periksa.no_rawat,pasien.no_rkm_medis,pasien.nm_pasien,
                pasien.tgl_lahir,hasil_pemeriksaan_usg_testis.tanggal,hasil_pemeriksaan_usg_testis.kd_dokter,
                dokter.nm_dokter,hasil_pemeriksaan_usg_testis.diagnosa_klinis,hasil_pemeriksaan_usg_testis.kiriman_dari,
                hasil_pemeriksaan_usg_testis.testis_kanan,hasil_pemeriksaan_usg_testis.testis_kiri,hasil_pemeriksaan_usg_testis.epididimis_kanan,
                hasil_pemeriksaan_usg_testis.epididimis_kiri,hasil_pemeriksaan_usg_testis.hidrokel,hasil_pemeriksaan_usg_testis.varikokel,
                hasil_pemeriksaan_usg_testis.dinding_skrotum,hasil_pemeriksaan_usg_testis.kesimpulan from reg_periksa inner join pasien on reg_periksa.no_rkm_medis=pasien.no_rkm_medis 
                inner join hasil_pemeriksaan_usg_testis on reg_periksa.no_rawat=hasil_pemeriksaan_usg_testis.no_rawat 
                inner join dokter on hasil_pemeriksaan_usg_testis.kd_dokter=dokter.kd_dokter]]>
