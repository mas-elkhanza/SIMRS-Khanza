<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Koneksi Wearable - SIMRS Khanza"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="URL Service"/>

        <EditText
            android:id="@+id/inputUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="http://server/epasien/service.php"
            android:inputType="textUri"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Token"
            android:paddingTop="8dp"/>

        <EditText
            android:id="@+id/inputToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tempel token dari halaman Koneksi Wearable"
            android:inputType="textMultiLine"
            android:minLines="2"/>

        <Button
            android:id="@+id/btnSimpan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simpan Pengaturan"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Variabel yang dikirim:"
            android:textStyle="bold"
            android:paddingTop="16dp"/>

        <LinearLayout
            android:id="@+id/wadahCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <Button
            android:id="@+id/btnIzin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Minta Izin Health Connect"
            android:layout_marginTop="16dp"/>

        <Button
            android:id="@+id/btnKirim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Baca dan Kirim Sekarang"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/teksStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: belum ada aksi"
            android:paddingTop="16dp"
            android:textIsSelectable="true"/>

    </LinearLayout>
</ScrollView>